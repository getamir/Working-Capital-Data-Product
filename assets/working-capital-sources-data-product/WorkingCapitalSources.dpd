      "authorization": {
        "definition": "POLICY \"WorkingCapitalSources.v1.WorkingCapitalSourcesCube\" {\n  GRANT READ ON \"c.bdc.8ddfzh0uzy38vt1gmuyov23tk.WorkingCapitalSources.v1.WorkingCapitalSourcesCube\" WHERE\n    c.bdc.8ddfzh0uzy38vt1gmuyov23tk.WorkingCapitalSources.v1.WorkingCapitalSourcesCube.CompanyCode IS NOT RESTRICTED AND\n    c.bdc.8ddfzh0uzy38vt1gmuyov23tk.WorkingCapitalSources.v1.WorkingCapitalSourcesCube.PostingDate IS NOT RESTRICTED AND\n    c.bdc.8ddfzh0uzy38vt1gmuyov23tk.WorkingCapitalSources.v1.WorkingCapitalSourcesCube.TransactionDate IS NOT RESTRICTED AND\n    c.bdc.8ddfzh0uzy38vt1gmuyov23tk.WorkingCapitalSources.v1.WorkingCapitalSourcesCube.TransactionCurrency IS NOT RESTRICTED AND\n    c.bdc.8ddfzh0uzy38vt1gmuyov23tk.WorkingCapitalSources.v1.WorkingCapitalSourcesCube.CompanyCodeCurrency IS NOT RESTRICTED AND\n    c.bdc.8ddfzh0uzy38vt1gmuyov23tk.WorkingCapitalSources.v1.WorkingCapitalSourcesCube.GlobalCurrency IS NOT RESTRICTED AND\n    c.bdc.8ddfzh0uzy38vt1gmuyov23tk.WorkingCapitalSources.v1.WorkingCapitalSourcesCube.BankAccountInternalID IS NOT RESTRICTED;\n}"
      }
    },
    "transformation": {
      "transformers": {
        "WorkingCapitalSourcesCubeTransformation": {
          "title": "Transformation for WorkingCapitalSourcesCube",
          "type": "sql-query",
          "inputs": [
            {
              "name": "sap.s4com:apiResource:CashFlow:v1.CashFlow"
            }
          ],
          "outputs": [
            {
              "name": "WorkingCapitalSourcesCube"
            }
          ],
          "definition": {
            "query": {
              "SELECT": {
                "from": {
                  "ref": [
                    "sap.s4com:apiResource:CashFlow:v1.CashFlow"
                  ],
                  "as": "CF"
                },
                "columns": [
                  {
                    "key": true,
                    "ref": [
                      "CF",
                      "CompanyCode"
                    ],
                    "as": "CompanyCode"
                  },
                  {
                    "ref": [
                      "CF",
                      "PostingDate"
                    ],
                    "as": "PostingDate"
                  },
                  {
                    "ref": [
                      "CF",
                      "TransactionDate"
                    ],
                    "as": "TransactionDate"
                  },
                  {
                    "ref": [
                      "CF",
                      "TransactionCurrency"
                    ],
                    "as": "TransactionCurrency"
                  },
                  {
                    "ref": [
                      "CF",
                      "CompanyCodeCurrency"
                    ],
                    "as": "CompanyCodeCurrency"
                  },
                  {
                    "ref": [
                      "CF",
                      "GlobalCurrency"
                    ],
                    "as": "GlobalCurrency"
                  },
                  {
                    "ref": [
                      "CF",
                      "BankAccountInternalID"
                    ],
                    "as": "BankAccountInternalID"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "ref": [
                              "CF",
                              "AmountInTransactionCurrency"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Decimal",
                          "precision": 34,
                          "scale": 4
                        }
                      }
                    ],
                    "as": "AmountInTransactionCurrency"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "xpr": [
                              "case",
                              "when",
                              {
                                "ref": [
                                  "CF",
                                  "AmountInTransactionCurrency"
                                ]
                              },
                              "is",
                              "not",
                              "null",
                              "then",
                              {
                                "val": 1
                              },
                              "else",
                              {
                                "val": 0
                              },
                              "end"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      }
                    ],
                    "as": "AmountInTransactionCurrencyCount"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "ref": [
                              "CF",
                              "AmountInCompanyCodeCurrency"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Decimal",
                          "precision": 34,
                          "scale": 4
                        }
                      }
                    ],
                    "as": "AmountInCompanyCodeCurrency"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "xpr": [
                              "case",
                              "when",
                              {
                                "ref": [
                                  "CF",
                                  "AmountInCompanyCodeCurrency"
                                ]
                              },
                              "is",
                              "not",
                              "null",
                              "then",
                              {
                                "val": 1
                              },
                              "else",
                              {
                                "val": 0
                              },
                              "end"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      }
                    ],
                    "as": "AmountInCompanyCodeCurrencyCount"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "ref": [
                              "CF",
                              "AmountInGlobalCurrency"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Decimal",
                          "precision": 34,
                          "scale": 4
                        }
                      }
                    ],
                    "as": "AmountInGlobalCurrency"
                  },
                  {
                    "xpr": [
                      {
                        "func": "SUM",
                        "args": [
                          {
                            "xpr": [
                              "case",
                              "when",
                              {
                                "ref": [
                                  "CF",
                                  "AmountInGlobalCurrency"
                                ]
                              },
                              "is",
                              "not",
                              "null",
                              "then",
                              {
                                "val": 1
                              },
                              "else",
                              {
                                "val": 0
                              },
                              "end"
                            ]
                          }
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      }
                    ],
                    "as": "AmountInGlobalCurrencyCount"
                  },
                  {
                    "xpr": [
                      {
                        "func": "COUNT",
                        "args": [
                          "*"
                        ],
                        "cast": {
                          "type": "cds.Integer"
                        }
                      }
                    ],
                    "as": "recordCount"
                  }
                ],
                "groupBy": [
                  {
                    "ref": [
                      "CF",
                      "CompanyCode"
                    ]
                  },
                  {
                    "ref": [
                      "CF",
                      "PostingDate"
                    ]
                  },
                  {
                    "ref": [
                      "CF",
                      "TransactionDate"
                    ]
                  },
                  {
