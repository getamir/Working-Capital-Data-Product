      "type": "derived",
      "category": "other",
      "name": "WorkingCapitalSources",
      "title": "Working Capital Sources",
      "shortDescription": "Unified working capital data combining ECC cash flows, accounts receivable from billing documents, and financial transactions for analytics and downstream consumption.",
      "description": "This data product consolidates three key working capital dimensions from SAP ECC: cash position and forecast data (via CashFlow), accounts receivable balances from customer billing (via BillingDocument), and treasury financial commitments (via FinancialTransaction). It provides finance and treasury teams with a governed, reusable view for liquidity monitoring, AR aging analysis, and treasury exposure reporting.",
      "responsible": "customer:vendor:Customer",
      "partOfPackage": "c.bdc.8ddfzh0uzy38vt1gmuyov23tk:package:dataProducts:v1"
    },
    "dpdInterop": "1.0",
    "meta": {
      "creator": "DPCA"
    },
